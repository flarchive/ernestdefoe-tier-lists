{
    "name": "ernestdefoe/tier-lists",
    "description": "Tier Lists: members rank anything by dragging it into S to F rows, remix each other's lists, and see where the crowd puts every item. Touch, keyboard and screen-reader friendly.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "tier list",
        "ranking",
        "remix",
        "community"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/tier-lists",
    "support": {
        "issues": "https://github.com/ernestdefoe/tier-lists/issues",
        "source": "https://github.com/ernestdefoe/tier-lists"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\TierLists\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\TierLists\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Tier Lists",
            "category": "feature",
            "icon": {
                "name": "fas fa-layer-group",
                "backgroundColor": "#7c3aed",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "flarum/tags",
                "fof/upload"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0",
        "fof/upload": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
